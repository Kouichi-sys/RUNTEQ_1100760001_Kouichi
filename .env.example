# このファイルをコピーして .env を作成する
#   cp .env.example .env
# .env は秘密情報を含むためコミットしない(.gitignore済み)

# Djangoの秘密鍵。本番では必ず推測されない値に差し替える
SECRET_KEY=dev-secret-key-change-me

# 開発環境では True、本番では False
DEBUG=True

# カンマ区切り。本番ではデプロイ先のホスト名を指定する
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL接続情報(compose.ymlのdbサービスを参照)
POSTGRES_DB=genba_camera
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@db:5432/genba_camera

# 映像取得元の切り替え
#   mock = サンプル画像を返す(社内LAN外・公開環境用)
#   nx   = NxWitness APIを参照する(社内LAN内)
VIDEO_SOURCE=mock

# VIDEO_SOURCE=nx のときのみ使用する
NX_BASE_URL=
NX_USERNAME=
NX_PASSWORD=

# レビュー用の公開環境(Render)でデモアカウントを作るときだけ設定する
# 未設定の場合、create_demo_userコマンドは何もしない
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
DEMO_USER_NAME=

# レビュー用のデモデータ(サーバー・カメラ)を投入するかどうか
CREATE_DEMO_CAMERAS=false
